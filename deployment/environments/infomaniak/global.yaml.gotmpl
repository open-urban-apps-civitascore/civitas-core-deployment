global:
  # *.dev.openurbanapps.org — wildcard A record at Cloudflare (DNS only)
  # pointing at the ingress LB 179.237.75.185.
  domain: 'dev.openurbanapps.org'
  instanceSlug: 'core'
  profile: 'development'

  serviceMesh:
    enable: false

  ingress:
    ingressClass: 'nginx'
    # Applied once via dev-deployment/letsencrypt-issuer.yaml. Switching away
    # from 'selfsigned-ca' also disables the CA distribution and every
    # component's certificate-check workaround (they all key on that name).
    clusterIssuer: 'letsencrypt'

components:
  - prepare
  - secrets
  # - networkpolicies
  - postgres
  - etcd
  - kafka
  - keycloak
  - authz
  - apisix
  - portal
  - civitas-marketplace  # Open Urban Apps addon (deployment/addons/civitas-marketplace)
  - frost            # SensorThings API (IoT)
  - nifi             # Data Pipelines
  - geoserver        # GIS & Geodaten-Sink
  - config-adapters  # Adapter zur Verknüpfung von NiFi & GeoServer
  - valkey           # Cache für Superset
  - superset         # BI-Dashboards
  - geoportal  # AppStore add-on (deployment/addons/geoportal)

