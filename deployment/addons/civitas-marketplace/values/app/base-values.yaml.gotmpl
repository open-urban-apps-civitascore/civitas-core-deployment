---
{{- $this := .Values.civitasMarketplace.app }}
{{- $global := .Values.global }}

image:
  repository: {{ .Values.images.civitasMarketplace.app.repository }}
  tag: {{ .Values.images.civitasMarketplace.app.tag }}
  pullPolicy: IfNotPresent

{{- $host := printf "%s.%s" (default "" $this.subdomain) $global.domain | trimPrefix "." }}

publicUrl: https://{{ $host }}

{{- $portalHost := printf "%s.%s" (default "" .Values.portal.portal.subdomain) $global.domain | trimPrefix "." }}
portalUrl: https://{{ $portalHost }}

# TODO: replace this dedicated ingress with an APISIX route soon, so the
# marketplace enters the cluster the same way as the portal BFF.
ingress:
  enabled: true
  className: {{ $global.ingress.ingressClass }}
  host: {{ $host }}
  tls:
    enabled: true
    secretName: marketplace-tls
    clusterIssuer: {{ $global.ingress.clusterIssuer }}

{{- $keycloakHost := printf "%s.%s" (default "" .Values.keycloak.app.subdomain) $global.domain | trimPrefix "." }}
{{- $keycloakPath := .Values.keycloak.app.pathPrefix | trimSuffix "/" }}
{{- $realmName := $global.instanceSlug }}

keycloak:
  clientId: marketplace
  realm: {{ $realmName }}
  # Browser-facing issuer (redirects, id_token validation).
  issuer: https://{{ $keycloakHost }}{{ $keycloakPath }}/realms/{{ $realmName }}
  # Container-internal issuer (token/userinfo/jwks) — same construction as
  # components/nifi/values/bootstrap/base-values.yaml.gotmpl.
  internalIssuer: http://keycloak-app-keycloakx-http.{{ .Values.keycloak.app.namespace }}.svc.cluster.local{{ $keycloakPath }}/realms/{{ $realmName }}
  # The realm signs id_tokens with ES256 (TR-03187 hardening in
  # components/keycloak/values/config); the app must expect the same.
  idTokenAlg: ES256
  # Generated by the secrets pipeline from keycloak-clients.yaml (confidential client).
  clientSecret:
    secretName: keycloak-client-marketplace
    key: client-secret

# The app talks to the platform through the APISIX gateway, never to the
# portal-backend directly.
api:
  baseUrl: http://apisix-gateway.{{ .Values.apisix.apisix.namespace }}.svc.cluster.local
  port: "80"

nextauthSecret:
  secretName: marketplace-nextauth-secret
  key: secret

# Self-signed cluster CA: Node rejects the certificate chain otherwise.
# (The portal frontend sets the same flag, with a TODO to mount the CA properly.)
{{- if eq $global.ingress.clusterIssuer "selfsigned-ca" }}
# Self-signed cluster CA: Node cannot verify the chain otherwise. With a real
# issuer the empty value keeps the env variable out of the pod entirely.
nodeTlsRejectUnauthorized: "0"
{{- else }}
nodeTlsRejectUnauthorized: ""
{{- end }}
