---
{{- $this := .Values.grafana.grafana }}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes
# - [ ] Graceful shutdown
# - [ ] Standard labels
# - [ ] ServiceAccount with least privilege where required
# - [ ] Named ports
# - [ ] Ingress with TLS

image:
  repository: {{ .Values.images.grafana.grafana.repository }}
  tag: {{ .Values.images.grafana.grafana.tag | quote }}

{{- $host := printf "%s.%s" (default "" $this.subdomain) $global.domain | trimPrefix "." }}

ingress:
  enabled: false

securityContext:
  runAsNonRoot: true
  runAsUser: 472
  runAsGroup: 472
  fsGroup: 472

containerSecurityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  runAsNonRoot: true
  runAsUser: 472
  runAsGroup: 472
  seccompProfile:
    type: RuntimeDefault
  capabilities:
    drop:
      - ALL

# readOnlyRootFilesystem (set above) needs a writable /tmp for Grafana features
# that use os.TempDir() (e.g. plugin install, CSV/image export).
extraEmptyDirMounts:
  - name: tmp
    mountPath: /tmp

# fsGroup: 472 (set above) already makes Kubernetes chown the PVC group-writable
# at mount time, so the root chown init container is redundant.
initChownData:
  enabled: false

persistence:
  enabled: true
  size: 5Gi

adminUser: admin

{{- $keycloakHost := printf "%s.%s" (default "" .Values.keycloak.app.subdomain) $global.domain | trimPrefix "." }}
{{- $keycloakPath := .Values.keycloak.app.pathPrefix | trimSuffix "/" }}
{{- $keycloakUrl := printf "https://%s%s" $keycloakHost $keycloakPath }}
{{- $realmName := $global.instanceSlug }}

grafana.ini:
  server:
    root_url: https://{{ $host }}
  auth:
    oauth_auto_login: true
    disable_login_form: true
  auth.generic_oauth:
    enabled: true
    name: Keycloak
    allow_sign_up: true
    client_id: grafana
    client_secret: ${GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET}
    scopes: openid
    email_attribute_path: email
    login_attribute_path: preferred_username
    name_attribute_path: name
    auth_url: {{ $keycloakUrl }}/realms/{{ $realmName }}/protocol/openid-connect/auth
    token_url: {{ $keycloakUrl }}/realms/{{ $realmName }}/protocol/openid-connect/token
    api_url: {{ $keycloakUrl }}/realms/{{ $realmName }}/protocol/openid-connect/userinfo
    signout_redirect_url: {{ $keycloakUrl }}/realms/{{ $realmName }}/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2F{{ $host }}%2Flogin&client_id=grafana
    use_pkce: true
    use_refresh_token: true
    allow_assign_grafana_admin: true
    role_attribute_path: contains(resource_access.grafana.roles[*], 'grafanaServerAdmin') && 'GrafanaAdmin' || contains(resource_access.grafana.roles[*], 'grafanaAdmin') && 'Admin' || contains(resource_access.grafana.roles[*], 'grafanaEditor') && 'Editor' || 'Viewer'

envValueFrom:
  GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
    secretKeyRef:
      name: keycloak-client-grafana
      key: client-secret
