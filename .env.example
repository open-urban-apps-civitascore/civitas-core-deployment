# =============================================================================
# Top-level environment file for local developer workflows (e.g. `just seed`).
#
# Copy this file to `.env` and adjust values as needed.
# =============================================================================

# Email / username of the initial admin user inside the Keycloak realm.
# Defaults to: admin@civitas.test
# AUTH_USER=admin@civitas.test

# Password for the above user.
# If set, the seed script assumes the user is already fully provisioned and
# will SKIP all kcadm.sh steps (password reset, clearing requiredActions, …).
# If empty, the script will generate an ephemeral password and force-set it
# through the keycloak pod.
# AUTH_PASSWORD=

# Kubernetes target
# KUBECONFIG=

# Namespace where platform is deployed.
# Defaults to: civitas
# NAMESPACE=civitas

# Keycloak realm name.
# Defaults to: civitas
# KEYCLOAK_REALM=civitas

# Base URL for the platform REST API used by the seeder.
# Defaults to: http://apisix-gateway.<NAMESPACE>.svc.cluster.local/v1
# API_BASE_URL=
