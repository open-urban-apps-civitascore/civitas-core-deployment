---
image:
  repository: {{ default "docker.io/adorsys/keycloak-config-cli" .Environment.Values.keycloak.config.image.repository }}
  tag: {{ default "6.4.0-26" .Environment.Values.keycloak.config.image.tag }}

backoffLimit: 2

job:
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: 200m
      memory: 512Mi

env:
  KEYCLOAK_AVAILABILITYCHECK_ENABLED: "true"
  KEYCLOAK_AVAILABILITYCHECK_RETRIES: {{ default "120s" .Environment.Values.keycloak.config.availabilityCheckTimeout }}
  KEYCLOAK_URL: http://keycloak-keycloakx-http.{{ .Environment.Values.keycloak.namespace }}.svc.cluster.local:80
  KEYCLOAK_USER: {{ default "admin" .Environment.Values.keycloak.admin.user }}
  IMPORT_FILES_LOCATIONS: /config/*
  IMPORT_VARSUBSTITUTION_ENABLED: "true"

existingSecret: {{ default "keycloak-admin-user" .Environment.Values.keycloak.admin.secret.name }}
existingSecretKey: {{ default "admin-password" .Environment.Values.keycloak.admin.secret.key }}

secrets:
  PORTAL_CLIENT_SECRET: {{ exec "sh" (list "-c" (printf "kubectl get secret portal-keycloak-secrets -n %s -o jsonpath='{.data.client-secret}' | base64 -d" .Environment.Values.portal.namespace)) | squote }}
  NEXTAUTH_SECRET: {{ exec "sh" (list "-c" (printf "kubectl get secret portal-nextauth-secret -n %s -o jsonpath='{.data.secret}' | base64 -d" .Environment.Values.portal.namespace)) | squote }}

config:
  {{ .Environment.Values.keycloak.config.realm.name }}:
    inline:
      id: {{ .Environment.Values.keycloak.config.realm.id }}
      realm: {{ .Environment.Values.keycloak.config.realm.name }}
      clients:
        - clientId: portal-frontend
          name: Portal Frontend
          description: CIVITAS Portal Frontend Application
          enabled: true
          protocol: openid-connect
          publicClient: false
          secret: "$(env:PORTAL_CLIENT_SECRET)"
          rootUrl: https://{{ .Environment.Values.portal.ingressDomain }}
          baseUrl: https://{{ .Environment.Values.portal.ingressDomain }}
          bearerOnly: false
          standardFlowEnabled: true
          implicitFlowEnabled: false
          directAccessGrantsEnabled: true
          serviceAccountsEnabled: false
          authorizationServicesEnabled: false
          redirectUris:
            - https://{{ .Environment.Values.portal.ingressDomain }}/*
            - http://localhost:3000/*
          webOrigins:
            - https://{{ .Environment.Values.portal.ingressDomain }}
            - http://localhost:3000
          defaultClientScopes:
            - email
            - profile
            - roles
            - web-origins
          optionalClientScopes:
            - address
            - phone
            - offline_access
            - microprofile-jwt
          attributes:
            post.logout.redirect.uris: +
            pkce.code.challenge.method: S256
