---
# Centralized secrets for all applications
# This file defines all secrets that will be generated and used across the platform

# Keep it mind that pod's don't automatically reload secrets when they change.
# So you may need to restart them. 
# E.g. `kubectl rollout restart deployment portal-frontend -n main-civitas2'

secrets:

  # Keycloak
  - name: {{ .Values.keycloak.admin.secret.name }}
    namespace: {{ .Values.keycloak.namespace }}
    keys:
      {{ .Values.keycloak.admin.secret.key }}: 16

  # Apicurio
  - name: apicurio-keycloak-secrets
    namespace: {{ .Values.apicurio.namespace }}
    keys:
      client-secret: 32
  - name: apicurio-ui-secrets
    namespace: {{ .Values.apicurio.namespace }}
    keys:
      client-secret: 32
  - name: apicurio-kafka-client
    namespace: {{ .Values.apicurio.namespace }}
    keys:
      id: 16
      secret: 32

  # Portal application secrets
  - name: portal-keycloak-secrets
    namespace: {{ .Values.portal.namespace }}
    keys:
      client-secret: 32

  - name: portal-nextauth-secret
    namespace: {{ .Values.portal.namespace }}
    keys:
      secret: 32

  # Etcd
  - name: etcd-root-password
    namespace: {{ .Values.etcd.namespace }}
    keys:
      root-password: 32
  - name: etcd-apisix-password
    namespace: {{ .Values.etcd.namespace }}
    keys:
      apisix-password: 32
  
  # Add more application secrets here as needed
  # Example for model-atlas:
  # - name: model-atlas-keycloak-secrets
  #   namespace: {{ .Values.modelAtlas.namespace }}
  #   keys:
  #     client-secret: 32
