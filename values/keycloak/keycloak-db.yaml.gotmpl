annotations: []

labels: []

name: {{ default "keycloak" .Environment.Values.keycloak.database.name }}

database:
  allowConnections: true
  builtinLocale:
  cluster:
    name: "{{ .Environment.Values.embeddedDatabase.cluster.name }}"
  collationVersion:
  connectionLimit:
  databaseReclaimPolicy:
  encoding:
  ensure: present
  extensions: []
  icuLocale:
  icuRules:
  isTemplate:
  locale:
  localeCType:
  localeCollate:
  localeProvider:
  name: "{{ default "keycloak" .Environment.Values.keycloak.database.name }}"
  owner: "{{ default "keycloak" .Environment.Values.keycloak.database.user }}"
  schemas: []
  tablespace:
  template:
  createSecret:
    enabled: true
    name: "{{ default "keycloak" .Environment.Values.keycloak.database.secret.name }}"
    username: "{{ default "keycloak" .Environment.Values.keycloak.database.user }}"
