---
# Model Atlas Values Template for Helmfile
# This file is processed by Helmfile and can use Go templating

image:
  repository: {{ .Values.modelAtlas.image.repository }}
  tag: {{ .Values.modelAtlas.image.tag }}
  pullPolicy: Always

replicaCount: 1

resources:
  requests:
    memory: {{ default "256Mi" .Values.modelAtlas.resources.requests.memory }}
    cpu: {{ default "100m" .Values.modelAtlas.resources.requests.cpu }}
  limits:
    memory: {{ default "512Mi" .Values.modelAtlas.resources.limits.memory }}
    cpu: {{ default "1000m" .Values.modelAtlas.resources.limits.cpu }}

ingress:
  enabled: {{ default false .Values.modelAtlas.ingress.enabled }}
  className: {{ default "nginx" .Values.modelAtlas.ingress.className }}
  annotations: {}
  hosts:
    - host: {{ default "model-atlas.local" (index .Values.modelAtlas.ingress.hosts 0).host }}
      paths:
        - path: {{ default "/" (index (index .Values.modelAtlas.ingress.hosts 0).paths 0).path }}
          pathType: {{ default "Prefix" (index (index .Values.modelAtlas.ingress.hosts 0).paths 0).pathType }}
  tls: []

# Service configuration
service:
  type: ClusterIP
  port: 8080

# Security context (best practices)
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  fsGroup: 1000
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  capabilities:
    drop:
    - ALL
  readOnlyRootFilesystem: true

# Volumes for read-only filesystem
volumes:
  - name: tmp
    emptyDir: {}
  - name: cache
    emptyDir: {}

volumeMounts:
  - name: tmp
    mountPath: /tmp
  - name: cache
    mountPath: /var/cache

