---
repositories:
  - name: keycloak-config-cli
    url: https://jkroepke.github.io/helm-charts/
---
environments:
  default:
    values:
      - ../environments/default/*.yaml
  local:
    values:
      - ../environments/local/*.yaml
---
helmDefaults:
  wait: true
  waitForJobs: true
---
releases:
  - name: portal-db
    namespace: >-
      {{ if .Environment.Values.embeddedDatabase.clusterWide }}
        {{ .Environment.Values.portal.namespace }}
      {{ else }}
        {{ .Environment.Values.embeddedDatabase.namespace }}
      {{ end }}
    chart: ../charts/database
    createNamespace: true
    installed: {{ .Environment.Values.databases.portal.embedded }}
    values:
      - ../values/portal/portal-db.yaml.gotmpl
  - name: portal-keycloak-config-cli
    namespace: '{{ .Environment.Values.portal.namespace }}'
    chart: keycloak-config-cli/keycloak-config-cli
    version: '{{ .Environment.Values.keycloak.config.chartVersion }}'
    createNamespace: true
    condition: portal.enabled
    values:
      - ../values/portal/portal-keycloak-config-cli.yaml.gotmpl
    hooks:
      - events: ['presync', 'preapply']
        command: 'sh'
        args:
          - '-c'
          - |
            # Generate portal client secret if it doesn't exist
            EXISTING_CLIENT_SECRET=$(kubectl get secret \
              portal-keycloak-secrets \
              -n {{ .Environment.Values.portal.namespace }} --ignore-not-found)
            if [ -z "$EXISTING_CLIENT_SECRET" ]; then
              CLIENT_SECRET=$(openssl rand -base64 32)
              kubectl create secret generic portal-keycloak-secrets \
                --from-literal=client-secret=$CLIENT_SECRET \
                -n {{ .Environment.Values.portal.namespace }} \
                --dry-run=client -o yaml | kubectl apply -f -
              echo "Created secret portal-keycloak-secrets in namespace {{ .Environment.Values.portal.namespace }}"
            else
              echo "Secret portal-keycloak-secrets already exists in namespace {{ .Environment.Values.portal.namespace }}, skipping creation."
            fi
            
            # Generate NextAuth secret if it doesn't exist
            EXISTING_NEXTAUTH_SECRET=$(kubectl get secret \
              portal-nextauth-secret \
              -n {{ .Environment.Values.portal.namespace }} --ignore-not-found)
            if [ -z "$EXISTING_NEXTAUTH_SECRET" ]; then
              NEXTAUTH_SECRET=$(openssl rand -base64 32)
              kubectl create secret generic portal-nextauth-secret \
                --from-literal=secret=$NEXTAUTH_SECRET \
                -n {{ .Environment.Values.portal.namespace }} \
                --dry-run=client -o yaml | kubectl apply -f -
              echo "Created secret portal-nextauth-secret in namespace {{ .Environment.Values.portal.namespace }}"
            else
              echo "Secret portal-nextauth-secret already exists in namespace {{ .Environment.Values.portal.namespace }}, skipping creation."
            fi
        showlogs: true
  - name: portal
    namespace: '{{ .Environment.Values.portal.namespace }}'
    chart: ../charts/portal
    version: '{{ .Environment.Values.portal.chartVersion }}'
    createNamespace: false
    needs:
      - portal-db
      - portal-keycloak-config-cli
    condition: portal.enabled
    values:
      - ../values/portal/portal.yaml.gotmpl
