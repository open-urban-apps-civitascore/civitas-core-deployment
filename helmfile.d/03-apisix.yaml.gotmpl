---
repositories:
  - name: apisix
    url: https://apache.github.io/apisix-helm-chart
---
environments:
  default:
    values:
      - ../environments/default/*.yaml
  dev:
    values:
      - ../environments/dev/values.yaml
---
helmDefaults:
  wait: true
  waitForJobs: true
---
releases:
  - name: apisix
    namespace: '{{ .Environment.Values.apisix.namespace }}'
    chart: apisix/apisix
    version: '{{ .Environment.Values.apisix.chartVersion }}'
    createNamespace: true
    condition: apisix.enabled
    values:
      - ../values/apisix/apisix.yaml.gotmpl
    hooks:
      - events: ['presync', 'preapply']
        command: 'sh'
        args:
          - '-c'
          - |
            EXISTING_SECRET=$(kubectl get secret \
              {{ .Environment.Values.apisix.apisix.admin.credentials.secretName }} \
              -n {{ .Environment.Values.apisix.namespace }} --ignore-not-found)
            if [ -z "$EXISTING_SECRET" ] || \
              [ "{{ .Environment.Values.apisix.apisix.admin.credentials.forceRecreateSecret }}" = "true" ]; then
              ADMIN_PASSWORD=$(openssl rand -base64 16)
              VIEWER_PASSWORD=$(openssl rand -base64 16)
              kubectl create secret generic \
                {{ .Environment.Values.apisix.apisix.admin.credentials.secretName }} \
                --from-literal={{
                  .Environment.Values.apisix.apisix.admin.credentials.secretAdminKey
                }}=$ADMIN_PASSWORD \
                --from-literal={{
                  .Environment.Values.apisix.apisix.admin.credentials.secretViewerKey
                }}=$VIEWER_PASSWORD \
                -n {{ .Environment.Values.apisix.namespace }} \
                --dry-run=client -o yaml | kubectl apply -f -
              echo "Created/Updated secret \
                {{ .Environment.Values.apisix.apisix.admin.credentials.secretName }} \
                in namespace {{ .Environment.Values.apisix.namespace }}"
            else
              echo "Secret \
                {{ .Environment.Values.apisix.apisix.admin.credentials.secretName }} \
                already exists in namespace {{ .Environment.Values.apisix.namespace }}, skipping creation."
            fi
        showlogs: false
