{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "enabledManagers": ["regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts from HTTP(S) repos in components/**/charts.yaml",
      "fileMatch": ["^components/.+/charts\\.yaml$"],
      "matchStrings": [
        "repository:\\s*(?<registryUrl>https?://[^\\s]+)\\s*\\n\\s*chart:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*version:\\s*['\\\"]?(?<currentValue>[^'\\\"\\n]+)['\\\"]?"
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "{{depName}}",
      "registryUrlTemplate": "{{registryUrl}}"
    },
    {
      "customType": "regex",
      "description": "OCI Helm charts in components/**/charts.yaml (handled as docker tags)",
      "fileMatch": ["^components/.+/charts\\.yaml$"],
      "matchStrings": [
        "chart:\\s*oci://(?<registryHost>[^/]+)/(?<imageName>[^\\s]+)\\s*\\n\\s*version:\\s*['\\\"]?(?<currentValue>[^'\\\"\\n]+)['\\\"]?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{registryHost}}/{{imageName}}"
    },
    {
      "customType": "regex",
      "description": "Container images in components/**/images.yaml",
      "fileMatch": ["^components/.+/images\\.yaml$"],
      "matchStrings": [
        "repository:\\s*['\\\"]?(?<imageName>[^'\\\"\\n]+)['\\\"]?\\s*tag:\\s*['\\\"]?(?<currentValue>[^'\\\"\\n]+)['\\\"]?"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "{{imageName}}"
    },
    {
      "customType": "regex",
      "description": "Container images in Dockerfiles with RENOVATE comment",
      "fileMatch": ["container-images/**/*"],
      "matchStrings": [
        "#\\s*RENOVATE:\\s*packageName=(?<depName>[\\w.-]+\\/[\\w.-]+)\\s*\\nENV\\s+[A-Z0-9_]+_VERSION=(?<currentValue>v?[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["helm", "docker"],
      "groupName": "Helm chart updates",
      "separateMinorPatch": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "^registry.gitlab.com/civitas-connect/civitas-core/civitas-core-v2/civitas-core-platform/.+$"
      ],
      "groupName": "Civitas Core Platform updates",
      "autoMerge": true
    }
  ]
}
