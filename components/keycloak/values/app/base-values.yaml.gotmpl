---
{{- $this := .Values.keycloak.app }}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> default in base chart
# - [ ] Graceful shutdown
# - [ ] Standard labels
# - [ ] ServiceAccount with least privilege where required
# - [ ] Named ports
# - [x] Ingress with TLS

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

image:
{{- with .Values.images.keycloak.app }}
  repository: {{ .repository }}
  tag: {{ .tag }}
{{- end }}
  pullPolicy: IfNotPresent
extraEnv: |
  - name: KC_HOSTNAME_STRICT
    value: "false"
  - name: JGROUPS_DISCOVERY_PROTOCOL
    value: kubernetes.KUBE_PING
  - name: JGROUPS_DISCOVERY_PROPERTIES
    value: dump_requests=true,port_range=0,namespace={{ $this.namespace }}
  - name: KC_BOOTSTRAP_ADMIN_USERNAME
    value: {{ $this.admin.username }}
  - name: KC_BOOTSTRAP_ADMIN_PASSWORD
    valueFrom:
      secretKeyRef:
        name: keycloak-admin-user
        key: password

ingress:
  enabled: {{ $global.ingress.enabled }}
  ingressClassName: {{ $global.ingress.ingressClass }}
  servicePort: http
  annotations:
    ingress.kubernetes.io/affinity: cookie
    cert-manager.io/cluster-issuer: {{ $global.ingress.clusterIssuer }}
  rules:
    {{- $host := printf "%s.%s" (default "" $this.subdomain) $global.domain | trimPrefix "." }}
    - host: {{ $host }}
      paths:
        - path: '{{ $this.pathPrefix }}'
          pathType: Prefix
  tls:
    - hosts:
        - {{ $host }}
      secretName: {{ $host }}-tls
  console:
    enabled: true
    ingressClassName: {{ $global.ingress.ingressClass }}
    annotations:
      ingress.kubernetes.io/affinity: cookie
      cert-manager.io/cluster-issuer: {{ $global.ingress.clusterIssuer }}
    rules:
      - host: {{ $host }}
        paths:
          - path: '{{ $this.pathPrefix | trimSuffix "/" }}/admin'
            pathType: Prefix
    tls:
      - hosts:
          - {{ $host }}
        secretName: {{ $host }}-tls
dbchecker:
  enabled: true
  image:
    {{- with .Values.images.keycloak.dbchecker }}
    repository: {{ .repository }}
    tag: {{ .tag }}
    {{- end }}
  resources:
    # resources are hardcoded, because dbchecker won't need more resources, even when the platform scales up
    requests:
      cpu: "20m"
      memory: "32Mi"
    limits:
      cpu: "20m"
      memory: "32Mi"
  securityContext:
    allowPrivilegeEscalation: false
    runAsUser: 1000
    runAsGroup: 1000
    runAsNonRoot: true

database:
  vendor: postgres
  hostname: {{ .Values.databases.keycloak.host }}
  port: {{ .Values.databases.keycloak.port }}
  database: {{ .Values.databases.keycloak.name }}
  username: {{ .Values.databases.keycloak.user }}
  existingSecret: {{ .Values.databases.keycloak.secret.name }}
  existingSecretKey: "password"
proxy:
  enabled: true
  mode: xforwarded
  http:
    enabled: true
metrics:
  enabled: {{ $global.metrics.enabled }}
serviceMonitor:
  enabled: {{ $global.metrics.enabled }}
  namespace: {{ $this.namespace }}

command:
  - "/opt/keycloak/bin/kc.sh"
  - "start"
http:
  relativePath: '{{ $this.pathPrefix }}'

livenessProbe: |
  httpGet:
    path: '{{ $this.pathPrefix | trimSuffix "/" }}/realms/master'
    port: 'http'
    scheme: 'HTTP'
  initialDelaySeconds: 0
  timeoutSeconds: 5
readinessProbe: |
  httpGet:
    path: '{{ $this.pathPrefix | trimSuffix "/" }}/realms/master'
    port: 'http'
    scheme: 'HTTP'
  initialDelaySeconds: 10
  timeoutSeconds: 1
startupProbe: |
  httpGet:
    path: '{{ $this.pathPrefix | trimSuffix "/" }}/realms/master'
    port: 'http'
    scheme: 'HTTP'
  initialDelaySeconds: 15
  timeoutSeconds: 1
  failureThreshold: 60
  periodSeconds: 5
health:
  enabled: true

# Config for readOnlyRootFilesystem
# see: https://github.com/keycloak/keycloak/issues/11286
extraInitContainers: |
  - name: prepare-keycloak-directories
    image: {{ .Values.images.keycloak.app.repository }}:{{ .Values.images.keycloak.app.tag }}
    imagePullPolicy: IfNotPresent
    securityContext:
      {{ .Values.securityDefaults.securityContext | toYaml | nindent 6 }}
    command:
      - sh
      - -c
    args:
      - |
        mkdir -p /app/{lib/quarkus,data,providers,themes}
        cp -r --preserve=mode,timestamps /opt/keycloak/lib/quarkus /app/lib
        cp -r --preserve=mode,timestamps /opt/keycloak/providers /app
        cp -r --preserve=mode,timestamps /opt/keycloak/themes /app
        cp -r --preserve=mode,timestamps /opt/keycloak/data /app
    volumeMounts:
      - name: workspace
        mountPath: /app
        subPath: app

extraVolumeMounts: |
  - name: workspace
    mountPath: /tmp
    subPath: tmp
  - name: workspace
    mountPath: /opt/keycloak/conf
    subPath: app/conf
  - name: workspace
    mountPath: /opt/keycloak/lib/quarkus
    subPath: app/lib/quarkus
  - name: workspace
    mountPath: /opt/keycloak/data
    subPath: app/data
  - name: workspace
    mountPath: /opt/keycloak/providers
    subPath: app/providers
  - name: workspace
    mountPath: /opt/keycloak/themes
    subPath: app/themes

extraVolumes: |
  - name: workspace
    emptyDir: {}