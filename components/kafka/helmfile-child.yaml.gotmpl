---
bases:
  - "../../bases/templates.yaml"
  - "../../bases/helm-defaults.yaml"
---
repositories:
  - name: kafbat-ui
    url: https://kafbat.github.io/helm-charts
---
releases:
  - name: kafka-operator
    namespace: {{ .Values.global.namespacePrefix }}-kafka-operator
    chart: oci://quay.io/strimzi-helm/strimzi-kafka-operator
    version: "0.48.0"
    createNamespace: true
    installed: {{ .Values.kafka.operator.enabled }}
    inherit:
      - template: default

  - name: kafka-cluster
    namespace: {{ .Values.global.namespacePrefix }}-kafka-cluster
    chart: charts/kafka
    createNamespace: true
    installed: {{ .Values.kafka.cluster.enabled }}
    inherit:
      - template: default

  - name: kafka-ui
    namespace: {{ .Values.global.namespacePrefix }}-kafka
    chart: kafbat-ui/kafka-ui
    version: "1.5.2"
    installed: {{ .Values.kafka.ui.enabled }}
    needs:
      - {{ .Values.global.namespacePrefix }}-kafka-cluster/kafka-cluster
    inherit:
      - template: default
