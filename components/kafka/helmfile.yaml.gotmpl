---
bases:
  - "../../bases/environments.yaml"
  - "../../bases/templates.yaml"
  - "../../bases/helm-defaults.yaml"
---
repositories:
  - name: kafbat-ui
    url: https://kafbat.github.io/helm-charts
---
{{- $templateData := dict
      "AllHelmfileValues" .Values
      "Component" "kafka"
      "Parts" (list "operator" "cluster" "ui")
      "SpecialLabels" (dict "operator" (dict "operator" true))
}}
{{ include "civitas.componentReleases" $templateData | indent 2 }}

---
commonLabels:
  component: kafka
