enabled: true
global:
  security:
    allowInsecureImages: true

image:
  registry: docker.io
  repository: bitnamilegacy/rabbitmq  # TODO: pin
# TODO: set resources in profiles
resources:
  limits:
    cpu: 2
    memory: 2Gi
  requests:
    cpu: 0.1
    memory: 512Mi
# set auth secret
auth:
  username: geoserver
  password: password
  erlangCookie: cookie
# TODO: enable persistence?
persistence:
  enabled: false
