---
{{- $this := .Values.geoserver.geoserver }}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> default
# - [ ] Graceful shutdown
# - [ ] Standard labels
# - [x] ServiceAccount with least privilege where required
# - [x] Named ports -> default
# - [x] Ingress with TLS -> ingress disabled

additionalVolumes: &additional-volumes
  cache:
    emptyDir: {}

additionalVolumeMounts: &additional-volume-mounts
  /mnt/cache:
    name: 'cache'

env: &env-override
  PG_PASSWORD:
    type: secret
    name: '{{ .Values.databases.geoserver.secret.name }}'
    key: 'password'
  RABBITMQ_HOST:
    value: 'gs-cloud-pgconfig-rabbitmq'
  RABBITMQ_USER:
    value: 'geoserver'
  RABBITMQ_PASSWORD:
    type: secret
    name: 'geoserver-rabbitmq-admin'
    key: 'rabbitmq-password'
  SPRING_PROFILES_ACTIVE:
    value: standalone,pgconfig
  GEOWEBCACHE_CACHE_DIR:
    value: '/mnt/cache'
  JAVA_OPTS:
    value: '$(JAVA_OPTS_DEFAULT) -XshowSettings:system'
  PGCONFIG_HOST:
    value: {{ .Values.databases.geoserver.host }}
  PGCONFIG_PORT:
    value: "{{ .Values.databases.geoserver.port }}"
  PGCONFIG_DATABASE:
    value: {{ .Values.databases.geoserver.name }}
  PGCONFIG_SCHEMA:
    value: public
  PGCONFIG_USERNAME:
    value: {{ .Values.databases.geoserver.user }}
  PGCONFIG_PASSWORD:
    type: secret
    name: '{{ .Values.databases.geoserver.secret.name }}'
    key: 'password'
  PGCONFIG_MAXCONNECTIONS:
    value: '10'
  GEOSERVER_WEB_GLOBALSERVICES:
    value: 'false'

additional-stuff: &additional-stuff
  volumes:
    <<: *additional-volumes
  containers:
    spring:
      env:
        <<: *env-override
      volumeMounts:
        <<: *additional-volume-mounts

global:
  profile: standalone,pgconfig
  image:
    pullPolicy: IfNotPresent
geoserver:
  ingress:
    enabled: false
  securityContext:
    {{ .Values.securityDefaults.securityContext | toYaml | nindent 4 }}
  podSecurityContext:
    {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 4 }}
  serviceAccount:
    create: true
    name: geoserver
  services:
    gateway:
      ingress:
        enabled: false
      <<: *additional-stuff
    webui:
      <<: *additional-stuff
    rest:
      replicaCount: 1
      <<: *additional-stuff
    wms:
      replicaCount: 1
      <<: *additional-stuff
    wcs:
      replicaCount: 1
      <<: *additional-stuff
    wfs:
      replicaCount: 1
      <<: *additional-stuff
    gwc:
      enabled: false
      replicaCount: 0
      <<: *additional-stuff
    wps:
      enabled: true
      replicaCount: 1
      <<: *additional-stuff
