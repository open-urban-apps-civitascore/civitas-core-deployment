---
bases:
  - "../../defaults/helm-defaults.yaml"
---
{{- $componentData := (readFile "./civitas-component.yaml" | fromYaml) }}

{{- $root := .Values }}
{{- $component := $componentData.component }}


{{- $managedNamespaces := dict }}
{{- range $component := ($root.components | default list) }}
  {{- if ne $component "namespaces" }}
    {{- $componentValues := index $root $component | default dict }}
    {{- range $partName, $partValues := $componentValues }}
      {{- if and (kindIs "map" $partValues) (hasKey $partValues "namespace") (or (not (hasKey $partValues "enabled")) (index $partValues "enabled")) }}
        {{- $namespace := index $partValues "namespace" }}
        {{- if $namespace }}
          {{- $_ := set $managedNamespaces $namespace true }}
        {{- end }}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- $namespaceNames := keys $managedNamespaces | sortAlpha }}
{{- $linkerdEnabled := and ($root.global.serviceMesh.enable | default false) (eq ($root.global.serviceMesh.type | default "") "linkerd") }}
{{- $createNamespaces := $root.global.createNamespaces | default false }}
{{- $patchNamespaces := and ($root.global.serviceMesh.enable | default false) ($root.global.serviceMesh.patchNamespaces | default false) }}
{{- $isDevelopment := eq ($root.global.profile | default "") "development" }}

hooks:
  - events: ["prepare"]
    showlogs: true
    command: sh
    args:
      - -ec
      - |
        set -eu
        cmd="{{`{{ .HelmfileCommand }}`}}"
        if [ "$cmd" != "sync" ] && [ "$cmd" != "apply" ]; then
          echo "Skipping prepare hook for helmfile command: $cmd"
          exit 0
        fi
        {{- if gt (len $namespaceNames) 0 }}
        {{- range $ns := $namespaceNames }}
        {{- if $createNamespaces }}
        kubectl get namespace {{ $ns | quote }} >/dev/null 2>&1 || kubectl create namespace {{ $ns | quote }}
        echo "Ensured namespace {{ $ns | quote }} exists."
        {{- end }}
        {{- if $patchNamespaces }}
        {{- if $linkerdEnabled }}
        kubectl annotate namespace {{ $ns | quote }} linkerd.io/inject=enabled --overwrite
        echo "Patched namespace {{ $ns | quote }} for Linkerd injection."
        {{- end }}
        {{- end }}
        {{- end }}
        {{- if $isDevelopment }}
        if kubectl get secret ca-secret -n cert-manager -o jsonpath='{.data.tls\.crt}' >/dev/null 2>&1; then
          CA_CERT=$(kubectl get secret ca-secret -n cert-manager -o jsonpath='{.data.tls\.crt}')
          {{- range $ns := $namespaceNames }}
          kubectl apply -f - <<EOF
        apiVersion: v1
        kind: Secret
        metadata:
          name: custom-ca-cert
          namespace: {{ $ns }}
        type: Opaque
        data:
          ca.crt: ${CA_CERT}
        EOF
          echo "Distributed CA certificate to namespace {{ $ns | quote }}."
          {{- end }}
        else
          echo "No access to ca-secret in cert-manager namespace. Skipping CA certificate distribution."
        fi
        {{- end }}
        {{- else }}
        echo "No namespaces configured."
        {{- end }}

commonLabels:
  component: {{ $component }}
