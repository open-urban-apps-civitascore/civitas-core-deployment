---
{{- $this := .Values.superset.superset }}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes
# - [x] Graceful shutdown
# - [x] Standard labels
# - [x] ServiceAccount with least privilege where required
# - [x] Named ports
# - [x] Ingress with TLS

runAsUser: 1000

{{- $initContainerImage := printf "%s/%s:%s" .Values.images.superset.init.registry .Values.images.superset.init.repository .Values.images.superset.init.tag }}
initContainers: &initContainers
  - name: wait-for-postgres-redis
    image: {{ $initContainerImage }}
    env:
      - name: DB_HOST
        value: {{ .Values.databases.superset.hostServiceName }}.{{ .Values.postgres.cluster.namespace }}.svc.cluster.local
      - name: DB_PORT
        value: {{ .Values.databases.superset.port | quote }}
      - name: REDIS_HOST
        value: valkey-valkey.{{ .Values.valkey.valkey.namespace }}.svc.cluster.local
      - name: REDIS_PORT
        value: "6379"
    command:
      - /bin/sh
      - -c
      - timeout 120 sh -c 'until nc -z "$DB_HOST" "$DB_PORT"; do sleep 2; done; until nc -z "$REDIS_HOST" "$REDIS_PORT"; do sleep 2; done'
    resources:
      limits:
        cpu: "500m"
        memory: "256Mi"
      requests:
        cpu: "250m"

security: &security
  podSecurityContext:
    {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 4 }}
  containerSecurityContext:
    {{ .Values.securityDefaults.securityContext | toYaml | nindent 4 }}

secretEnv:
  create: false

serviceAccountName: superset
serviceAccount:
  create: true

extraVolumes:
  - name: temp
    emptyDir: {}
  {{- if eq $global.ingress.clusterIssuer "selfsigned-ca" }}
  - name: custom-ca-cert
    secret:
      secretName: custom-ca-cert
      items:
        - key: ca.crt
          path: custom-ca.crt
  {{- end }}

extraVolumeMounts:
  - name: temp
    mountPath: /tmp
  {{- if eq $global.ingress.clusterIssuer "selfsigned-ca" }}
  - name: custom-ca-cert
    mountPath: /etc/ssl/certs/custom-ca.crt
    subPath: custom-ca.crt
    readOnly: true
  {{- end }}


{{- $keycloakHost := printf "%s.%s" (default "" .Values.keycloak.app.subdomain) $global.domain | trimPrefix "." }}
{{- $keycloakPath := .Values.keycloak.app.pathPrefix | trimSuffix "/" }}
{{- $keycloakUrl := printf "https://%s%s" $keycloakHost $keycloakPath }}
{{- $realmName := $global.instanceSlug }}
{{- $oidcIssuer := printf "%s/realms/%s" ($keycloakUrl | trimSuffix "/") $realmName }}

extraEnvRaw:
    - name: REDIS_HOST
      value: valkey-valkey.{{ .Values.valkey.valkey.namespace }}.svc.cluster.local
    - name: REDIS_PORT
      value: "6379"
    - name: REDIS_USER
      value: "superset"
    - name: REDIS_PASSWORD
      valueFrom:
        secretKeyRef:
          name: valkey-users
          key: superset
    - name: REDIS_CACHE_DB
      value: "1"
    - name: REDIS_CELERY_DB
      value: "0"
    - name: REDIS_PROTO
      value: redis
    - name: DB_HOST
      value: {{ .Values.databases.superset.hostServiceName }}.{{ .Values.postgres.cluster.namespace }}.svc.cluster.local
    - name: DB_PORT
      value: {{ .Values.databases.superset.port | quote }}
    - name: DB_USER
      value: {{ .Values.databases.superset.user | quote }}
    - name: DB_PASS
      valueFrom:
        secretKeyRef:
          name: {{ .Values.databases.superset.secret.name | quote }}
          key: {{ .Values.databases.superset.secret.key | quote }}
    - name: DB_NAME
      value: {{ .Values.databases.superset.name | quote }}
    - name: SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: secret-key
          key: secret-key
    - name: CLIENT_SECRET
      valueFrom:
        secretKeyRef:
          name: keycloak-client-superset
          key: client-secret
    - name: CLIENT_ID
      value: superset
    - name: OIDC_ISSUER
      value: {{ $oidcIssuer }}
    {{- if eq $global.ingress.clusterIssuer "selfsigned-ca" }}
    - name: REQUESTS_CA_BUNDLE
      value: /etc/ssl/certs/custom-ca.crt
    - name: SSL_CERT_FILE
      value: /etc/ssl/certs/custom-ca.crt
    {{- end }}


keycloak:
  authServerUrl: {{ $keycloakUrl }}
  realm: {{ $realmName }}

configOverrides:
  enable_oauth: |
    from flask import redirect, request, session
    from flask_appbuilder import expose
    from flask_appbuilder.security.manager import AUTH_OAUTH
    from flask_appbuilder.security.views import AuthOAuthView
    from flask_login import login_user
    from superset.security import SupersetSecurityManager
    import logging
    import os

    log = logging.getLogger(__name__)

    AUTH_TYPE = AUTH_OAUTH
    AUTH_USER_REGISTRATION = True
    AUTH_ROLES_SYNC_AT_LOGIN = True
    AUTH_USER_REGISTRATION_ROLE = "Gamma"
    ENABLE_PROXY_FIX = True
    PREFERRED_URL_SCHEME = 'https'
    PROXY_FIX_CONFIG = {
      'x_for': 1,
      'x_proto': 1,
      'x_host': 1,
      'x_port': 1,
      'x_prefix': 1,
    }

    PROVIDER_NAME = 'keycloak'
    CLIENT_ID = os.getenv('CLIENT_ID')
    CLIENT_SECRET = os.getenv('CLIENT_SECRET')
    OIDC_ISSUER = os.getenv('OIDC_ISSUER')
    OIDC_BASE_URL = f'{OIDC_ISSUER}/protocol/openid-connect'
    OIDC_AUTH_URL = f'{OIDC_BASE_URL}/auth'
    OIDC_METADATA_URL = f'{OIDC_ISSUER}/.well-known/openid-configuration'
    OIDC_TOKEN_URL = f'{OIDC_BASE_URL}/token'
    OIDC_USERINFO_URL = f'{OIDC_BASE_URL}/userinfo'
    OAUTH_PROVIDERS = [
        {
            'name': PROVIDER_NAME,
            'token_key': 'access_token',
            'icon': 'fa-circle-o',
            'remote_app': {
                'api_base_url': OIDC_BASE_URL,
                'access_token_url': OIDC_TOKEN_URL,
                'authorize_url': OIDC_AUTH_URL,
                'request_token_url': None,
                'server_metadata_url': OIDC_METADATA_URL,
                'client_id': CLIENT_ID,
                'client_secret': CLIENT_SECRET,
                'client_kwargs': {
                    'scope': 'openid email profile',
                    'code_challenge_method': 'S256',
                    'response_type': 'code',
                },
            },
        }
    ]

    AUTH_ROLES_MAPPING = {
      "admin": ["Admin"]
    }

    class CustomOAuthView(AuthOAuthView):
      @expose('/login/')
      @expose('/login/<provider>')
      def login(self, provider=None):
        if not provider:
          next_url = request.args.get('next')
          if next_url:
            return redirect(f'/login/{PROVIDER_NAME}?next={next_url}')
          return redirect(f'/login/{PROVIDER_NAME}')

        if provider not in self.appbuilder.sm.oauth_remotes:
          return redirect(self.appbuilder.get_url_for_login)

        redirect_uri = f'https://{request.host}/oauth-authorized/{provider}'
        return self.appbuilder.sm.oauth_remotes[provider].authorize_redirect(
          redirect_uri=redirect_uri
        )

      @expose('/logout/', methods=['GET', 'POST'])
      def logout(self):
        super().logout()
        session.clear()
        return redirect(
          f'{OIDC_ISSUER}/protocol/openid-connect/logout?post_logout_redirect_uri={request.url_root.strip("/")}&client_id={CLIENT_ID}'
        )

      @expose('/oauth-authorized/<provider>')
      def oauth_authorized(self, provider):
        try:
          resp = self.appbuilder.sm.oauth_remotes[provider].authorize_access_token()
        except Exception as e:
          log.exception(f'Error fetching access token: {e}')
          return redirect(self.appbuilder.get_url_for_index)

        userinfo = self.appbuilder.sm.get_oauth_user_info(provider, resp)
        role_keys = userinfo.get('role_keys', [])
        
        # If AUTH_ROLES_MAPPING is configured, filter to known groups
        # Otherwise, allow any authenticated user
        if AUTH_ROLES_MAPPING:
          known_groups = [g for g in role_keys if g in AUTH_ROLES_MAPPING]
          if not known_groups:
            log.warning(
              f'No valid groups for user {userinfo.get("username")}, groups received: {role_keys}'
            )
            return redirect(self.appbuilder.get_url_for_login)
          userinfo['role_keys'] = known_groups
        else:
          log.info(f'No AUTH_ROLES_MAPPING configured, allowing authenticated user {userinfo.get("username")}')
        
        user = self.appbuilder.sm.auth_user_oauth(userinfo)
        if user is None:
          log.warning(
            f'auth_user_oauth returned None for user {userinfo.get("username")}'
          )
          return redirect(self.appbuilder.get_url_for_index)

        login_user(user, remember=False)
        return redirect(self.appbuilder.get_url_for_index)


    class CustomSsoSecurityManager(SupersetSecurityManager):
        authoauthview = CustomOAuthView

        def get_oauth_user_info(self, provider, response):
            if provider == 'keycloak':
                me = self.appbuilder.sm.oauth_remotes[provider].get(OIDC_USERINFO_URL)
                me.raise_for_status()
                data = me.json()
                log.info(f'Received userinfo from OIDC provider for user {data.get("preferred_username")}')

                groups = data.get('groups', [])

                return {
                    'username': data.get('preferred_username'),
                    'email': data.get('email'),
                    'first_name': data.get('given_name'),
                    'last_name': data.get('family_name'),
                    'role_keys': groups,
                }
            return {}


    CUSTOM_SECURITY_MANAGER = CustomSsoSecurityManager
  redis_auth: |
    from urllib.parse import quote_plus

    _redis_user = env('REDIS_USER', '')
    _redis_password = env('REDIS_PASSWORD', '')
    _redis_auth = ''

    if _redis_password:
      if _redis_user:
        _redis_auth = f"{quote_plus(_redis_user)}:{quote_plus(_redis_password)}@"
      else:
        _redis_auth = f":{quote_plus(_redis_password)}@"

    REDIS_BASE_URL = f"{env('REDIS_PROTO')}://{_redis_auth}{env('REDIS_HOST')}:{env('REDIS_PORT')}"
    CACHE_REDIS_URL = f"{REDIS_BASE_URL}/{env('REDIS_CACHE_DB', 1)}{REDIS_URL_PARAMS}"
    CELERY_REDIS_URL = f"{REDIS_BASE_URL}/{env('REDIS_CELERY_DB', 0)}{REDIS_URL_PARAMS}"

    CACHE_CONFIG = {
      'CACHE_TYPE': 'RedisCache',
      'CACHE_DEFAULT_TIMEOUT': 300,
      'CACHE_KEY_PREFIX': 'superset_',
      'CACHE_REDIS_URL': CACHE_REDIS_URL,
    }
    DATA_CACHE_CONFIG = CACHE_CONFIG

    class CeleryConfig:
      imports = ('superset.sql_lab',)
      broker_url = CELERY_REDIS_URL
      result_backend = CELERY_REDIS_URL

    CELERY_CONFIG = CeleryConfig
    RESULTS_BACKEND = RedisCache(
      host=env('REDIS_HOST'),
      port=env('REDIS_PORT'),
      db=env('REDIS_CACHE_DB', 1),
      password=_redis_password,
      key_prefix='superset_results',
    )
  secret: |
    SECRET_KEY = os.getenv("SECRET_KEY", "CHANGE-ME")

image:
  repository: {{ .Values.images.superset.superset.registry }}/{{ .Values.images.superset.superset.repository }}
  tag: {{ .Values.images.superset.superset.tag }}

initImage:
  repository: {{ .Values.images.superset.init.registry }}/{{ .Values.images.superset.init.repository }}
  tag: {{ .Values.images.superset.init.tag }}

supersetNode:
  initContainers: *initContainers
  <<: *security

supersetWorker:
  replicas:
    enabled: true
  initContainers: *initContainers
  <<: *security

supersetCeleryBeat:
  enabled: false

supersetCeleryFlower:
  enabled: false

supersetWebsockets:
  enabled: false

init:
  createAdmin: false
  initContainers: *initContainers
  <<: *security

postgresql:
  enabled: false

redis:
  enabled: false