---
{{- $this := .Values.configAdapters.adapters }}
{{- $global := .Values.global }}
# Checklist:
# - [x] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> default in chart
# - [ ] Graceful shutdown
# - [ ] Standard labels
# - [ ] ServiceAccount with least privilege where required # TODO: use SA for keycloak access
# - [x] Named ports -> default in chart
# - [x] Ingress with TLS -> not applicable

# Service Mesh configuration (passed from global values)
customServiceMesh:
  enable: {{ $global.serviceMesh.enable | default false }}
  type: {{ $global.serviceMesh.type | default "" | quote }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

fullnameOverride: "config-adapter"

image:
  repository: {{ .Values.images.configAdapters.adapters.repository }}
  tag: {{ .Values.images.configAdapters.adapters.tag }}

# The container runs with readOnlyRootFilesystem=true (see checklist above), which
# makes the default temp dir (/tmp -> java.io.tmpdir) read-only. Jersey's
# MultiPartReaderClientSide calls File.createTempFile() during REST client setup
# (NifiSagaHandler.createClient), which then fails with
# "java.io.IOException: Read-only file system". Mount a writable emptyDir at /tmp
# so temp files (and JVM scratch space) can be created.
volumes:
  - name: tmp
    emptyDir: {}

volumeMounts:
  - name: tmp
    mountPath: /tmp

env:
  # Ensure the JVM and all libraries (incl. Jersey multipart) write temp files to
  # the writable /tmp emptyDir mounted above, despite readOnlyRootFilesystem.
  - name: TMPDIR
    value: "/tmp"
  - name: JAVA_TOOL_OPTIONS
    value: "-Djava.io.tmpdir=/tmp"

  # Adapter configuration
  - name: ADAPTERS
    value: "apisix,keycloak,frost"

  - name: EVENTHANDLER_NAME
    value: "kafka"

  # Kafka configuration
  - name: KAFKA_BOOTSTRAP_SERVERS
    value: "{{ .Values.kafka.cluster.bootstrapService }}:{{ .Values.kafka.cluster.bootstrapPort }}"
  - name: KAFKA_GROUP_ID
    value: config-adapter-group

  # Keycloak configuration — uses dedicated config-adapter client with password grant
  {{- $keycloakUrl := printf "http://keycloak-app-keycloakx-http.%s.svc.cluster.local:80" .Values.keycloak.app.namespace -}}
  {{- $realmName := $global.instanceSlug }}
  - name: KEYCLOAK_URL
    value: {{ $keycloakUrl | quote }}
  - name: KEYCLOAK_REALM
    value: {{ $realmName | quote }}
  - name: KEYCLOAK_USERNAME
    value: "config-adapter@internal.local"
  - name: KEYCLOAK_PASSWORD
    valueFrom:
      secretKeyRef:
        name: "config-adapter-keycloak-user"
        key: "password"
  - name: KEYCLOAK_CLIENT_ID
    value: "config-adapter"
  - name: KEYCLOAK_INVITATION_CLIENT_ID
    value: "portal-frontend"
  - name: KEYCLOAK_INVITATION_REDIRECT_URI
    value: "https://portal.{{ $global.domain }}/"
  # Keycloak Topics:
  # User Events (7): user.created, user.updated, user.deleted, user.locked, user.unlocked, user.password.changed, user.password.reset
  # Realm Events (3): realm.created, realm.updated, realm.deleted
  # Client Events (3): client.created, client.updated, client.deleted
  # Role Events (3): role.created, role.updated, role.deleted
  # Group Events (3): group.created, group.updated, group.deleted
  - name: KEYCLOAK_TOPICS
    value: "de.civitascore.idm.user.created,de.civitascore.idm.user.updated,de.civitascore.idm.user.deleted,de.civitascore.idm.user.locked,de.civitascore.idm.user.unlocked,de.civitascore.idm.user.password.changed,de.civitascore.idm.user.password.reset,de.civitascore.idm.realm.created,de.civitascore.idm.realm.updated,de.civitascore.idm.realm.deleted,de.civitascore.idm.client.created,de.civitascore.idm.client.updated,de.civitascore.idm.client.deleted,de.civitascore.idm.role.created,de.civitascore.idm.role.updated,de.civitascore.idm.role.deleted,de.civitascore.idm.group.created,de.civitascore.idm.group.updated,de.civitascore.idm.group.deleted"

  # APISIX configuration
  {{- $apisixHost := printf "%s.%s" (default "" .Values.apisix.apisix.subdomain) $global.domain | trimPrefix "." }}
  {{- $apisixPath := .Values.apisix.apisix.pathPrefix }}
  {{- $apisixUrl := printf "http://%s%s" "apisix-admin:9180" $apisixPath }}
  {{- $apisixDataHost := printf "apisix-gateway.%s.svc.cluster.local:9080" .Values.apisix.apisix.namespace }}
  {{- $apisixDataPublicUrl := printf "https://api.%s" $global.domain }}
  - name: APISIX_ADMIN_URL
    value: {{ $apisixUrl | quote }}
  - name: APISIX_ADMIN_KEY
    valueFrom:
      secretKeyRef:
        name: "apisix-admin-credentials"
        key: "admin"
  - name: APISIX_DATA_HOST
    value: {{ $apisixDataHost | quote }}
  - name: APISIX_DATA_HOST_URL
    value: {{ $apisixDataPublicUrl | quote }}
  - name: APISIX_TOPICS
    value: "de.civitascore.api.backend.created,de.civitascore.api.backend.updated,de.civitascore.api.backend.deleted,de.civitascore.api.route.created,de.civitascore.api.route.updated,de.civitascore.api.route.deleted"
  - name: APISIX_API_HOST
    value: {{ $apisixHost | quote }}
  - name: APISIX_API_PUBLIC_HOST
    value: {{ $apisixHost | quote }}
  - name: APISIX_PLUGIN_CONFIG_ID
    value: "portal-backend"
  - name: APISIX_FROST_BASIC_AUTH_USERNAME
    value: "admin"
  - name: APISIX_FROST_BASIC_AUTH_PASSWORD
    value: "admin"

  # FROST configuration (accessed via linkerd service mesh, basic auth)
  {{- $frostUrl := printf "http://frost-frost-frost-server-http.%s/FROST-Server/v1.1" .Values.frost.frost.namespace }}
  - name: FROST_URL
    value: {{ $frostUrl | quote }}
  - name: FROST_PUBLIC_URL
    value: {{ $frostUrl | quote }}
  - name: FROST_BASIC_AUTH_USERNAME
    value: "admin"
  - name: FROST_BASIC_AUTH_PASSWORD
    value: "admin"
  - name: FROST_TOPICS
    value: "de.civitascore.data.thing.created,de.civitascore.data.thing.updated,de.civitascore.data.thing.deleted,de.civitascore.data.location.created,de.civitascore.data.location.updated,de.civitascore.data.location.deleted,de.civitascore.data.sensor.created,de.civitascore.data.sensor.updated,de.civitascore.data.sensor.deleted,de.civitascore.data.observedproperty.created,de.civitascore.data.observedproperty.updated,de.civitascore.data.observedproperty.deleted,de.civitascore.data.datastream.created,de.civitascore.data.datastream.updated,de.civitascore.data.datastream.deleted,de.civitascore.data.project.created,de.civitascore.data.project.updated,de.civitascore.data.project.deleted"

  # NiFi configuration — uses `nifi-direct` client with DAG/password grant.
  {{- $nifiUrl := printf "https://nifi-nifi.%s.svc.cluster.local:8443/nifi-api" .Values.nifi.nifi.namespace }}
  {{- $nifiTokenUrl := printf "%s/realms/%s/protocol/openid-connect/token" $keycloakUrl $realmName }}
  - name: NIFI_URL
    value: {{ $nifiUrl | quote }}
  - name: NIFI_OIDC_TOKEN_URL
    value: {{ $nifiTokenUrl | quote }}
  - name: NIFI_OIDC_CLIENT_ID
    value: "nifi-direct"
  - name: NIFI_USERNAME
    value: "nifi-config-adapter@internal.local"
  - name: NIFI_PASSWORD
    valueFrom:
      secretKeyRef:
        name: "nifi-config-adapter-keycloak-user"
        key: "password"
  # Skipping NiFi's self-signed cert verification is intentional: all traffic is
  # cluster-internal (nifi-nifi.<namespace>.svc.cluster.local:8443) and already
  # protected by the Linkerd service mesh (mTLS). Not a public-facing path.
  - name: NIFI_TLS_INSECURE_SKIP_VERIFY
    value: "true"
  # FROST sink target for NiFi-provisioned data pipelines (SensorThings base URL).
  - name: NIFI_FROST_URL
    value: {{ $frostUrl | quote }}
  # PostGIS sink DB for NiFi-provisioned pipelines. Reuses the `payload_data`
  # PostGIS-enabled database (declared in components/geoserver/databases.yaml,
  # secret `db-payload-data`). Without these, PostGIS deploys fail with
  # NIFI_TEMPLATE_ERROR.
  - name: NIFI_POSTGIS_URL
    value: "jdbc:postgresql://postgres-cluster-rw:5432/payload_data"
  - name: NIFI_POSTGIS_USER
    value: "payload_data"
  - name: NIFI_POSTGIS_PASSWORD
    valueFrom:
      secretKeyRef:
        name: "db-payload-data"
        key: "password"
  - name: POSTGIS_JDBC_URL
    value: "jdbc:postgresql://postgres-cluster-rw:5432/payload_data"
  - name: POSTGIS_JDBC_USER
    value: "payload_data"
  - name: POSTGIS_JDBC_PASSWORD
    valueFrom:
      secretKeyRef:
        name: "db-payload-data"
        key: "password"
  - name: NIFI_TOPICS
    value: "de.civitascore.data.flow.created,de.civitascore.data.flow.updated,de.civitascore.data.flow.deleted"

  # Crypto configuration (shared with portal backend)
  - name: CIVITAS_MASTER_KEY
    valueFrom:
      secretKeyRef:
        name: "portal-backend-crypto"
        key: "civitas-master-key"

  # Flowable configuration
  - name: FLOWABLE_JDBC_URL
    value: jdbc:postgresql://{{ .Values.databases.flowable.host }}:{{ .Values.databases.flowable.port }}/{{ .Values.databases.flowable.name }}
  - name: FLOWABLE_JDBC_USERNAME
    value: {{ .Values.databases.flowable.user }}
  - name: FLOWABLE_JDBC_PASSWORD
    valueFrom:
      secretKeyRef:
        name: "db-flowable"
        key: "password"

  # Health check configuration
  - name: HEALTHCHECK_PORT
    value: "8080"

  # GeoServer configuration
  {{- $geoserverRestUrl := printf "http://geoserver-geoserver-rest.%s/geoserver" .Values.geoserver.geoserver.namespace }}
  - name: GEOSERVER_URL
    value: {{ $geoserverRestUrl | quote }}
  - name: GEOSERVER_PUBLIC_URL
    value: "https://geoserver.{{ $global.domain }}/geoserver" # TODO: check why this is needed. because this would not work
  - name: GEOSERVER_ADMIN_USER
    value: "admin"
  - name: GEOSERVER_ADMIN_PASSWORD
    value: "geoserver"
  - name: GEOSERVER_POSTGIS_HOST
    value: "postgres-cluster-rw"
  - name: GEOSERVER_POSTGIS_PORT
    value: "5432"
  - name: GEOSERVER_POSTGIS_DATABASE
    value: "payload_data"
  - name: GEOSERVER_POSTGIS_SCHEMA
    value: "public"
  - name: GEOSERVER_POSTGIS_USER
    value: "payload_data"
  - name: GEOSERVER_POSTGIS_PASSWORD
    valueFrom:
      secretKeyRef:
        name: "db-payload-data"
        key: "password"
