---
{{- $this := .Values.apisix.apisix }}
{{- $global := .Values.global }}
# Checklist:
# - [ ] Containers run as non-root with `readOnlyRootFilesystem`
# - [x] Health probes -> enabled by default in chart
# - [x] Graceful shutdown -> handled by chart
# - [ ] Standard labels
# - [x] ServiceAccount with least privilege where required
# - [x] Named ports -> handled by chart
# - [ ] Ingress with TLS -> not applicable, APISIX is the gateway itself

fullnameOverride: apisix

# Container images
image:
  repository: {{ .Values.images.apisix.apisix.gateway.repository }}
  tag: {{ .Values.images.apisix.apisix.gateway.tag }}
  pullPolicy: IfNotPresent

serviceAccount:
  create: true

rbac:
  create: true

podSecurityContext:
  {{ .Values.securityDefaults.podSecurityContext | toYaml | nindent 2 }}

securityContext:
  {{ .Values.securityDefaults.securityContext | toYaml | nindent 2 }}

# External etcd configuration with RBAC
etcd:
  enabled: false

externalEtcd:
  host:
    - http://etcd-etcd-client.{{ .Values.etcd.etcd.namespace }}.svc.cluster.local:2379
  user: "apisix"
  existingSecret: "etcd-apisix-password"
  secretPasswordKey: "apisix-password"

# Config to ensure functionality with read-only filesystem
# Ensures that /usr/local/apisix/conf and /tmp are writable, while also preserving
# the default configuration by copying it in an init container.
{{- $writableVolumes := dict
  "conf" "/usr/local/apisix/conf"
  "tmp" "/tmp"
  "body-tmp" "/usr/local/apisix/client_body_temp"
  "proxy-tmp" "/usr/local/apisix/proxy_temp"
  "fastcgi-tmp" "/usr/local/apisix/fastcgi_temp"
  "uwsgi-tmp" "/usr/local/apisix/uwsgi_temp"
  "scgi-tmp" "/usr/local/apisix/scgi_temp"
  "logs" "/usr/local/apisix/logs"
}}

extraVolumes:
{{- range $name, $path := $writableVolumes }}
  - name: apisix-{{ $name }}-writable
    emptyDir: { }
{{- end }}

extraVolumeMounts:
{{- range $name, $path := $writableVolumes }}
  - name: apisix-{{ $name }}-writable
    mountPath: {{ $path }}
{{- end }}

extraInitContainers:
  - name: copy-apisix-conf
    image: {{ .Values.images.apisix.apisix.gateway.repository }}:{{ .Values.images.apisix.apisix.gateway.tag }}
    imagePullPolicy: IfNotPresent
    command: ["/bin/sh", "-c"]
    args:
      - cp -r /usr/local/apisix/conf/* /mnt/apisix-conf/ ;
    volumeMounts:
      - name: apisix-conf-writable
        mountPath: /mnt/apisix-conf
    securityContext:
      {{ .Values.securityDefaults.securityContext | toYaml | nindent 8 }}

# APISIX Gateway configuration
apisix:
  prometheus:
    enabled: {{ $global.metrics.enabled }}
  admin:
    enabled: true
    ingress:
      enabled: {{ $global.ingress.enabled }}
      annotations:
        kubernetes.io/ingress.class: {{ $global.ingress.ingressClass }}
        cert-manager.io/cluster-issuer: {{ $global.ingress.clusterIssuer }}
      {{- $host := printf "%s.%s" (default "" $this.subdomain) $global.domain | trimPrefix "." }}
      hosts:
        - host: {{ $host }}
          paths:
            - '{{ $this.pathPrefix }}'
      className: {{ $global.ingress.ingressClass }}
      tls:
        - hosts:
            - {{ $host }}
          secretName: {{ $host }}-tls
    credentials:
      secretName: apisix-admin-credentials
      secretAdminKey: admin
      secretViewerKey: viewer
  nginx:
    configurationSnippet:
      httpEnd: |
        proxy_buffer_size 32k;
        proxy_buffers 4 32k;
        client_header_buffer_size 16k;
        large_client_header_buffers 4 16k;

# Ingress Controller
ingress-controller:
  enabled: false

# Metrics
metrics:
  serviceMonitor:
    enabled: {{ $global.metrics.enabled }}

extraContainers:
  - name: apisix-initial-config
    image: {{ .Values.images.apisix.apisix.apisixInitialConfig.repository }}:{{ .Values.images.apisix.apisix.apisixInitialConfig.tag }}
    imagePullPolicy: IfNotPresent
    command: ["/bin/sh", "-c"]
    env:
      - name: APISIX_ADMIN_KEY
        valueFrom:
          secretKeyRef:
            name: apisix-admin-credentials
            key: admin
    ttlSecondsAfterFinished: 300
    resources:
      limits:
        cpu: 100m
        memory: 128Mi
      requests:
        cpu: 50m
        memory: 64Mi
    securityContext:
      {{ .Values.securityDefaults.securityContext | toYaml | nindent 8 }}
    args:
      - |
        # Wait for APISIX to be ready
        timeout 15s sh -c 'echo "Waiting for APISIX to be ready..."; until nc -z 127.0.0.1 9180; do sleep 2; done'

        # Create initial configuration using APISIX Admin API
        echo "Creating initial configuration in APISIX..."
        # Example: Create a simple route (customize as needed)


        curl -s -X PUT http://localhost:9180/apisix/admin/services/svc-portal-backend -H "X-API-KEY: ${APISIX_ADMIN_KEY}" -H "Content-Type: application/json" -d '{
          "name": "portal-backend",
          "desc": "Portal Backend API Service",
          "upstream": {
            "type": "roundrobin",
            "nodes": {
              "portal-portal-backend.{{ $global.instanceSlug }}.svc.cluster.local:8089": 1
            },
            "timeout": {
              "connect": 6,
              "send": 6,
              "read": 6
            }
          }
        }' || exit 1

        curl -s -X PUT http://localhost:9180/apisix/admin/plugin_configs/openid_opa_proxy_rewrite_request_id -H "X-API-KEY: ${APISIX_ADMIN_KEY}" -H "Content-Type: application/json" -d '{
          "name": "openid_opa_proxy_rewrite_request_id",
          "desc": "Combined plugin config for auth + authz + request ID",
          "plugins": {
            "openid-connect": {
              "client_id": "apisix-validator",
              "client_secret": "unused-for-jwks-validation",
              "discovery": "http://keycloak-app-keycloakx-http.{{ $global.instanceSlug }}.svc.cluster.local:80/realms/{{ $global.instanceSlug }}/.well-known/openid-configuration",
              "bearer_only": true,
              "use_jwks": true,
              "ssl_verify": false,
              "set_userinfo_header": true
            },
            "opa": {
              "host": "http://authz-authz-opa.{{ $global.instanceSlug }}.svc.cluster.local:8181",
              "policy": "civitas/authz/decision",
              "with_route": true,
              "with_service": true,
              "with_consumer": false,
              "send_headers_upstream": [
                "X-Allowed-Scope-Ids"
              ]
            },
            "proxy-rewrite": {
              "headers": {
                "remove": [
                  "X-Allowed-Scope-Ids"
                ]
              }
            },
            "request-id": {
              "include_in_response": true
            }
          }
        }' || exit 1

        curl -s -X PUT http://localhost:9180/apisix/admin/routes/portal-backend-api -H "X-API-KEY: ${APISIX_ADMIN_KEY}" -H "Content-Type: application/json" -d '{
          "name": "Portal Backend API (AuthZ)",
          "uri": "/v2/*",
          "service_id": "svc-portal-backend",
          "plugin_config_id": "openid_opa_proxy_rewrite_request_id"
        }' || exit 1

        # TODO: find a better way to solve that:
        # - job requires extra chart
        # - initContainer runs before APISIX is ready, chicken egg problem
        # - sidecar runs after APISIX is ready, but cannot finish without restarting
        sleep infinity
