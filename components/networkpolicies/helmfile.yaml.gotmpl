---
bases:
  - "../../defaults/helm-defaults.yaml"
---
{{- $componentData := (readFile "./civitas-component.yaml" | fromYaml) }}

{{- $root := .Values }}
{{- $component := $componentData.component }}
{{- $parts :=  $componentData.parts }}

repositories:
{{- $alreadyAdded := dict }}
{{- range $parts }}
  {{- $part := . }}
  {{- $repoUrl := index $root.charts $component $part.name "repository" | default "" }}
  {{- if ne $repoUrl "" }}
    {{- $chart := index $root.charts $component $part.name "chart" }}
    {{- $chartParts := splitList "/" $chart }}
    {{- $repoName := index $chartParts 0 }}
    {{- if not (hasKey $alreadyAdded $repoName) }}
      {{- $_ := set $alreadyAdded $repoName true }}
  - name: cc2-{{ $repoName }}
    url: {{ $repoUrl }}
    {{- end }}
  {{- end }}
{{- end }}

releases:
  {{- $allNetworkPolicies := index $root "networkpolicies" | default dict }}
  {{- range $policyComponentName, $policyConfig := $allNetworkPolicies }}
    {{- if ne $policyComponentName "networkpolicies" }}
      {{- $sourceComponent := index $policyConfig "_component" | default $policyComponentName }}
      {{- $targetComponentData := index $root $sourceComponent | default dict }}
      {{- $targetNamespace := "" }}
      {{- range $partKey, $partData := $targetComponentData }}
        {{- if and (kindIs "map" $partData) (hasKey $partData "namespace") }}
          {{- $targetNamespace = index $partData "namespace" }}
          {{- break }}
        {{- end }}
      {{- end }}
      {{- if hasKey $policyConfig "namespace" }}
        {{- $targetNamespace = $policyConfig.namespace }}
      {{- end }}
      {{- if $targetNamespace }}
        {{- $transformedConfig := dict }}
        {{- range $key, $value := $policyConfig }}
          {{- if eq $key "_component" }}
            {{- /* Skip the component metadata field */ -}}
          {{- else if or (eq $key "ingress") (eq $key "egress") }}
            {{- $transformedRules := list }}
            {{- range $rule := $value }}
              {{- $transformedRule := dict }}
              {{- $directionKey := "from" }}
              {{- if eq $key "egress" }}
                {{- $directionKey = "to" }}
              {{- end }}
              {{- if hasKey $rule $directionKey }}
                {{- $transformedPeers := list }}
                {{- range $peer := (index $rule $directionKey) }}
                  {{- $transformedPeer := dict }}
                  {{- range $peerKey, $peerValue := $peer }}
                    {{- if eq $peerKey "componentNamespace" }}
                      {{- /* Resolve $partData: the map (a component part) expected to carry a
                             "namespace" key. Dotted "component.part" targets a specific part
                             (e.g. "postgres.operator" -> the operator namespace, which differs
                             from the cluster namespace in the multi-instance model); a bare
                             component name resolves to its first namespaced part. */ -}}
                      {{- $refNamespace := "" }}
                      {{- $partData := dict }}
                      {{- $dotted := splitList "." $peerValue }}
                      {{- if gt (len $dotted) 1 }}
                        {{- $refComponentData := index $root (index $dotted 0) | default dict }}
                        {{- $partData = index $refComponentData (index $dotted 1) | default dict }}
                      {{- else }}
                        {{- $refComponentData := index $root $peerValue | default dict }}
                        {{- if not $refComponentData }}
                          {{- $parts := splitList "-" $peerValue }}
                          {{- $camelCase := index $parts 0 }}
                          {{- range $i, $part := $parts }}
                            {{- if gt $i 0 }}
                              {{- $camelCase = printf "%s%s" $camelCase ($part | title) }}
                            {{- end }}
                          {{- end }}
                          {{- $refComponentData = index $root $camelCase | default dict }}
                        {{- end }}
                        {{- range $partKey, $candidate := $refComponentData }}
                          {{- if and (kindIs "map" $candidate) (hasKey $candidate "namespace") }}
                            {{- $partData = $candidate }}
                            {{- break }}
                          {{- end }}
                        {{- end }}
                      {{- end }}
                      {{- if and (kindIs "map" $partData) (hasKey $partData "namespace") }}
                        {{- $refNamespace = index $partData "namespace" }}
                      {{- end }}
                      {{- if $refNamespace }}
                        {{- $_ := set $transformedPeer "namespaceSelector" (dict "matchLabels" (dict "kubernetes.io/metadata.name" $refNamespace)) }}
                      {{- end }}
                    {{- else }}
                      {{- $_ := set $transformedPeer $peerKey $peerValue }}
                    {{- end }}
                  {{- end }}
                  {{- $transformedPeers = append $transformedPeers $transformedPeer }}
                {{- end }}
                {{- $_ := set $transformedRule $directionKey $transformedPeers }}
              {{- end }}
              {{- range $ruleKey, $ruleValue := $rule }}
                {{- if ne $ruleKey $directionKey }}
                  {{- $_ := set $transformedRule $ruleKey $ruleValue }}
                {{- end }}
              {{- end }}
              {{- $transformedRules = append $transformedRules $transformedRule }}
            {{- end }}
            {{- $_ := set $transformedConfig $key $transformedRules }}
          {{- else }}
            {{- $_ := set $transformedConfig $key $value }}
          {{- end }}
        {{- end }}
        {{- $releaseName := printf "%s-%s" $component $policyComponentName }}
  - name: {{ $releaseName }}
    labels:
      release: {{ $releaseName }}
      policy-name: {{ $policyComponentName }}
    namespace: {{ $targetNamespace }}
    chart: ./charts/networkpolicies
    createNamespace: {{ $root.global.createNamespaces }}
    installed: {{ index $root $component "networkpolicies" "enabled" | default true }}
    values:
      - networkpolicies:
          {{ $policyComponentName }}:
            {{- $transformedConfig | toYaml | nindent 12 }}
            namespace: {{ $targetNamespace }}
      {{- end }}
    {{- end }}
  {{- end }}

commonLabels:
  component: {{ $component }}
