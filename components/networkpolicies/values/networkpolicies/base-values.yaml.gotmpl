---
{{- $global := .Values.global }}

{{- /*
  resolveComponentNamespace: returns the namespace string for a given component name.
  Searches the component's top-level values map for any sub-map that contains a "namespace" key.
  Args (dict):
    .component  - the component name (string)
    .values     - the root .Values object
*/ -}}
{{- define "resolveComponentNamespace" -}}
  {{- $componentData := index .values .component | default dict -}}
  {{- range $_, $partData := $componentData -}}
    {{- if and (kindIs "map" $partData) (hasKey $partData "namespace") -}}
      {{- index $partData "namespace" -}}
      {{- break -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

# Pass the collected networkpolicies from defaults/environment/networkpolicies.yaml.gotmpl
# to the chart so it can create NetworkPolicy resources
#
# This template automatically injects namespaceSelector for secure-by-default policies:
# - No namespaceSelector key = auto-inject instanceSlug namespace
# - namespaceSelector: "string" = use literal namespace name
# - namespaceSelector: {} = allow all namespaces (explicit opt-in)
networkpolicies:
{{- range $policyName, $policyConfig := .Values.networkpolicies }}
  {{- if ne $policyName "networkpolicies" }}
  {{ $policyName }}:
  {{- range $key, $value := $policyConfig }}
    {{- if not (has $key (list "egress" "ingress")) }}
    {{ $key }}:
      {{- toYaml $value | nindent 6 }}
    {{- end }}
  {{- end }}
  {{- /* ingress uses "from" peers, egress uses "to" peers; both render identically */}}
  {{- range $direction := list (dict "key" "ingress" "peerKey" "from") (dict "key" "egress" "peerKey" "to") }}
  {{- if hasKey $policyConfig $direction.key }}
    {{ $direction.key }}:
    {{- range (index $policyConfig $direction.key) }}
    {{- $rule := . }}
    - {{- if hasKey $rule $direction.peerKey }}
      {{ $direction.peerKey }}:
      {{- range (index $rule $direction.peerKey) }}
      {{- $peer := . }}
      - {{- if hasKey $peer "componentNamespace" }}
          {{- $refNamespace := include "resolveComponentNamespace" (dict "component" $peer.componentNamespace "values" $.Values) | trim }}
          {{- if $refNamespace }}
        namespaceSelector:
          matchLabels:
            kubernetes.io/metadata.name: {{ $refNamespace }}
          {{- end }}
        {{- else if hasKey $peer "namespaceSelector" }}
          {{- if eq (typeOf $peer.namespaceSelector) "string" }}
        namespaceSelector:
          matchLabels:
            kubernetes.io/metadata.name: {{ $peer.namespaceSelector }}
          {{- else }}

        namespaceSelector:
          {{- toYaml $peer.namespaceSelector | nindent 10 }}
          {{- end }}
        {{- else if hasKey $peer "podSelector" }}
        namespaceSelector:
          matchLabels:
            kubernetes.io/metadata.name: {{ if hasKey $policyConfig "namespace" }}{{ $policyConfig.namespace }}{{ else }}{{ $global.instanceSlug }}{{ end }}
        {{- end }}
        {{- if hasKey $peer "podSelector" }}
        podSelector:
          {{- toYaml $peer.podSelector | nindent 10 }}
        {{- end }}
        {{- if hasKey $peer "ipBlock" }}
        ipBlock:
          {{- toYaml $peer.ipBlock | nindent 10 }}
        {{- end }}
      {{- end }}
      {{- end }}
      {{- if hasKey $rule "ports" }}
      ports:
        {{- toYaml $rule.ports | nindent 6 }}
      {{- end }}
    {{- end }}
  {{- end }}
  {{- end }}
  {{- end }}
{{- end }}