---
postgres:
  operator:
    enabled: true
    namespace: {{ include "civitas.operatorNamespace" (dict "global" .Values.global "suffix" "postgres" "deployLayer" .Values.deployLayer) }}
  cluster:
    enabled: true
    namespace: {{ include "civitas.namespace" (dict "global" .Values.global "suffix" "postgres") }}
    name: postgres-cluster
    recovery:
      s3:
        accessKey: ""
        secretKey: ""
  databases:
    enabled: true
    namespace: {{ include "civitas.namespace" (dict "global" .Values.global "suffix" "postgres") }}
