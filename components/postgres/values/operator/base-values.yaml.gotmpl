---
{{- $this := .Values.postgres.operator -}}
{{- $global := .Values.global }}

# values: https://github.com/cloudnative-pg/charts/blob/main/charts/cloudnative-pg/values.yaml
# raw: https://raw.githubusercontent.com/cloudnative-pg/charts/refs/heads/main/charts/cloudnative-pg/values.yaml
# - [ ] Containers run as non-root with `readOnlyRootFilesystem`
# - [ ] Health probes
# - [ ] Graceful shutdown
# - [ ] Standard labels
# - [ ] ServiceAccount with least privilege where required
# - [ ] Named ports
# - [ ] Ingress with TLS

# clusterWide=true makes the CNPG operator watch ALL namespaces (empty WATCH_NAMESPACE),
# so a single shared operator reconciles the Postgres clusters of every instance.
# Driven by global.operators.watchAllNamespaces via default-environment.yaml.gotmpl;
# defaults to false (operator watches only its own namespace) for legacy single-instance.
config:
  clusterWide: {{ $this.clusterWide | default false }}
