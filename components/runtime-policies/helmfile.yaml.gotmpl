---
bases:
  - "../../defaults/helm-defaults.yaml"
---
{{- $root := .Values }}
{{- $linkerdEnabled := and ($root.global.serviceMesh.enable | default false) (eq ($root.global.serviceMesh.type | default "") "linkerd") }}
{{- $failureAction := index ($root.global.runtimePolicies | default dict) "failureAction" | default "Audit" }}
{{- $enabled := index ($root.global.runtimePolicies | default dict) "enabled" | default false }}
{{- $namespace := index $root "runtime-policies" "runtime-policies" "namespace" }}
{{- /* Operator namespaces, used to pin the reverse label-protection rules to the
       full operator SA username. Fall back to the release namespace if the
       component is not deployed. */}}
{{- $strimziOperatorNamespace := ((($root.kafka | default dict).operator | default dict).namespace | default $namespace) }}
{{- $cnpgOperatorNamespace := ((($root.postgres | default dict).operator | default dict).namespace | default $namespace) }}
{{- /* These are cluster-scoped ClusterPolicy objects with fixed names, so they must
       be created ONCE per cluster. Render them in the shared operator layer (and the
       legacy all-in-one deployment, deployLayer ""), but NOT per instance — otherwise
       every instance's release would fight over the same cluster-scoped resources. */}}
{{- $layer := $root.deployLayer | default "" }}

releases:
  {{- if or (eq $layer "") (eq $layer "operators") }}
  - name: runtime-policies
    namespace: {{ $namespace }}
    chart: ./charts/runtime-policies
    createNamespace: {{ $root.global.createNamespaces }}
    installed: {{ $enabled }}
    values:
      - operators:
          enabled: true
        strimziOperatorNamespace: {{ $strimziOperatorNamespace }}
        cnpgOperatorNamespace: {{ $cnpgOperatorNamespace }}
        linkerd:
          enabled: {{ $linkerdEnabled }}
        failureAction: {{ $failureAction }}
  {{- end }}

commonLabels:
  component: runtime-policies
