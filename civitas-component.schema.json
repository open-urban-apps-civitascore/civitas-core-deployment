{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Civitas component schema",
  "type": "object",
  "required": ["component", "parts"],
  "properties": {
    "component": {
      "type": "string",
      "minLength": 1
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "extraLabels": {
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z0-9_.-]+$": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
